PROJECT_NAME="Claire AI Social Media Manager API"
ENVIRONMENT="development"
PORT=8000

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Tavily Research API
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Rate limiting (set RATE_LIMIT_ENABLED=false in local dev if needed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare Workers AI (optional — enables real image generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
