# ==============================================================================
# Claire AI - Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and fill in your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# [REQUIRED] Project title displayed in OpenAPI docs
PROJECT_NAME="Claire AI Social Media Manager API"

# [REQUIRED] Environment runtime mode ("development", "staging", or "production")
ENVIRONMENT="development"

# [REQUIRED] Server port (Render automatically overrides this with $PORT)
PORT=8000


# ------------------------------------------------------------------------------
# 2. GROQ AI ENGINE (REQUIRED)
# ------------------------------------------------------------------------------
# [REQUIRED] Groq API Key for Llama 3.3 70B inferencing & Whisper voice transcription
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=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

# [OPTIONAL] Main text LLM model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# [OPTIONAL] Voice transcription model (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3


# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & AUTHENTICATION (REQUIRED FOR AUTH & MEMORY)
# ------------------------------------------------------------------------------
# [REQUIRED] Supabase project URL for multi-user isolation & persistent chat memory
# Find at: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://giyysqtxfbrosgaqcxkq.supabase.co

# [REQUIRED] Supabase service role key (bypasses RLS for backend agent state saving)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdpeXlzcXR4ZmJyb3NnYXFjeGtxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTQ5ODk3MSwiZXhwIjoyMTAxMDc0OTcxfQ.grppmx8CvcnmyZjO8ECMvH2BW-beCoejA6F1TRUu_Po

# [OPTIONAL] Supabase anonymous key (used for client verification fallback)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdpeXlzcXR4ZmJyb3NnYXFjeGtxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0OTg5NzEsImV4cCI6MjEwMTA3NDk3MX0.je8p-mk4ItzPCblFXESuk5yHOJrav9rcpXysPOoOpxs


# ------------------------------------------------------------------------------
# 4. AUTHENTICATION ENFORCEMENT
# ------------------------------------------------------------------------------
# [OPTIONAL] Set to true to strictly require Bearer JWT token on all /api/v1/* routes.
# If false (default), unauthenticated requests fall back to guest sessions.
REQUIRE_AUTH=false


# ------------------------------------------------------------------------------
# 5. TAVILY RESEARCH API (OPTIONAL)
# ------------------------------------------------------------------------------
# [OPTIONAL] Tavily API key for real-time web search and market research agent tool
# Get key at: https://tavily.com
TAVILY_API_KEY=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


# ------------------------------------------------------------------------------
# 6. CLOUDFLARE WORKERS AI (OPTIONAL - IMAGE GENERATION)
# ------------------------------------------------------------------------------
# [OPTIONAL] Cloudflare Account ID & API Token for Stable Diffusion XL image generation
# Get keys at: Cloudflare Dashboard -> Workers AI
CLOUDFLARE_ACCOUNT_ID=77176bd1f3cbbc21b4748aa84f63ea3b
CLOUDFLARE_API_TOKEN=cfat_cidK635Qkhk9hETlRbpQfd2U9nehF2Scybldux0bc3ddb27f
CLOUDFLARE_AI_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning


# ------------------------------------------------------------------------------
# 7. SECURITY & CORS SETTINGS
# ------------------------------------------------------------------------------
# [REQUIRED] Allowed origins list for CORS (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://claireai-ruby.vercel.app"]

# [OPTIONAL] Regex pattern matching dynamic deployment origins (e.g. Vercel preview deployments)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app


# ------------------------------------------------------------------------------
# 8. RATE LIMITING
# ------------------------------------------------------------------------------
# [OPTIONAL] Enable sliding window rate limiter (recommended for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

