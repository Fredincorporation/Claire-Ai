# ==============================================================================
# Claire AI - Frontend Environment Configuration (.env.example)
# Copy this file to frontend/.env.local and fill in your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API BASE URL (REQUIRED)
# ------------------------------------------------------------------------------
# [REQUIRED] Full base URL to the Claire AI FastAPI backend service.
# Local development: http://localhost:8000
# Production deployment: https://claire-ai-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & PERSISTENCE (OPTIONAL - REQUIRED FOR EMAIL/PASS AUTH)
# ------------------------------------------------------------------------------
# [OPTIONAL] Supabase URL for client-side authentication and session handling.
# If unset, Claire AI automatically operates in Guest / Demo mode.
# Find at: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# [OPTIONAL] Supabase public anonymous key for client requests.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-keys


