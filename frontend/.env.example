# Claire AI Frontend Environment Variables

# Backend API base URL (local or Render endpoint)
# Local: http://localhost:8000
# Production: https://claire-ai-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth & Persistence Configuration (Get from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

