# ==============================================================================
# CLAIRE AI - CONSOLIDATED ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# This file provides a complete overview of all environment variables required
# for both the Backend (FastAPI) and Frontend (Next.js 15).
#
# Usage:
# - Copy backend settings into backend/.env
# - Copy frontend settings into frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------

# App & Server Settings
PROJECT_NAME="Claire AI Social Media Manager API"
ENVIRONMENT="development"
PORT=8000

# Groq AI Engine (REQUIRED)
# Get your free key at: https://console.groq.com/keys
